{
  "worktree": {
    "baseRef": "head"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(pnpm build)",
      "Bash(pnpm test *)",
      "Bash(pnpm typecheck)",
      "Bash(git status)",
      "Bash(git diff)"
    ],
    "ask": ["Bash(git push *)", "Bash(git commit *)"],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Bash(git commit * --no-verify*)",
      "Bash(git commit -n *)"
    ]
  }
}
